[package]
name = "@name@-firmware"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
cortex-m = { version = "=0.7.10", features = ["inline-asm"] }
cortex-m-rt = "=0.7.7"
defmt = "=1.2.0"
defmt-rtt = "=1.3.1"
embassy-executor = { version = "=0.10.0", features = ["platform-cortex-m", "executor-thread", "defmt"] }
embassy-rp = { version = "=0.10.0", features = ["defmt", "rp2040", "time-driver", "critical-section-impl"] }
embassy-time = { version = "=0.5.1", features = ["defmt", "defmt-timestamp-uptime"] }
panic-probe = { version = "=1.0.0", features = ["print-defmt"] }

[profile.release]
debug = 2
lto = "fat"
codegen-units = 1
opt-level = "s"

[workspace]
