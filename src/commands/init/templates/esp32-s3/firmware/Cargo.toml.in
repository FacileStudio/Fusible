[package]
name = "@name@-firmware"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
embassy-executor = "=0.10.0"
embassy-time = "=0.5.1"
esp-backtrace = { version = "=0.20.0", features = ["esp32s3", "panic-handler", "println"] }
esp-bootloader-esp-idf = { version = "=0.6.0", features = ["esp32s3"] }
esp-hal = { version = "=1.2.2", features = ["esp32s3", "unstable"] }
esp-println = { version = "=0.18.0", features = ["esp32s3"] }
esp-rtos = { version = "=0.4.0", features = ["esp32s3", "embassy"] }

[profile.dev]
opt-level = "s"

[profile.release]
debug = 2
lto = "fat"
codegen-units = 1
opt-level = "s"

[workspace]
